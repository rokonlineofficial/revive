# Hostinger deploys this repo as-is (no build step).
# The built website lives in /site, so serve everything from there.

AddType application/javascript .js .mjs
AddType text/css .css
AddType image/svg+xml .svg

# Never let browsers keep an old copy of the page
<IfModule mod_headers.c>
  <FilesMatch "\.html$">
    Header unset Expires
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
</IfModule>

RewriteEngine On
RewriteBase /

# Old cached pages ask for the source file; send a script that reloads the page fresh
RewriteRule ^src/main\.jsx$ site/reload.js [L]

# Real files inside /site (JS, CSS, images, favicon...)
RewriteCond %{REQUEST_URI} !^/site/
RewriteCond %{DOCUMENT_ROOT}/site%{REQUEST_URI} -f
RewriteRule ^(.*)$ site/$1 [L]

# Everything else (/, /about-us, /contact...) loads the app
RewriteCond %{REQUEST_URI} !^/site/
RewriteRule ^ site/index.html [L]
